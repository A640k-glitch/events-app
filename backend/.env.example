# Port
PORT=5000
NODE_ENV=development

# Neon Serverless PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / JWT Authentication Secret
NEXTAUTH_SECRET="super-secret-jwt-key-for-fifthlab-events"
NEXTAUTH_URL="http://localhost:3000"

# Azure Active Directory (Single Sign-On for @thefifthlab.com)
AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="your-azure-ad-tenant-id"

# Development Mock Auth Bypass (true for local mock login without Azure credentials)
ENABLE_DEV_AUTH_BYPASS=true

# Nodemailer / Gmail SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@thefifthlab.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="FifthLab Events <notifications@thefifthlab.com>"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"
