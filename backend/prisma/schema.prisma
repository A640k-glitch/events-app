generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  SALES
  OPS
  PRODUCT_OWNER
  VISITOR
}

enum EventPriority {
  HIGH
  MEDIUM
  LOW
}

enum EventCategory {
  CONFERENCE
  SUMMIT
  EXPOSITION
  EXECUTIVE_BRIEFING
  WEBINAR
}

enum AttendanceStatus {
  ATTENDING
  DECLINED
  MAYBE
}

enum LeadStatus {
  UNREAD
  FOLLOWED_UP
  QUALIFIED
  CONVERTED
  CLOSED
}

enum TicketTier {
  FREE_VISITOR
  PRO_ORGANIZER
  ENTERPRISE_PARTNER
}

enum PitchStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DECLINED
}

// 🏢 Corporate FifthLab Users & Staff (@thefifthlab.com only)
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  role          UserRole  @default(STAFF)
  avatarUrl     String?
  timezone      String    @default("WAT")
  workingHours  String?   @default("9:00 AM - 5:00 PM")
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rsvps         AttendanceRecord[]
  assignedLeads Lead[]
  ownedProducts Product[]

  @@map("users")
}

// 📅 Published Events Catalog
model Event {
  id                  String        @id @default(cuid())
  title               String
  category            EventCategory @default(CONFERENCE)
  priority            EventPriority @default(MEDIUM)
  date                DateTime
  time                String
  location            String
  city                String
  country             String        @default("Nigeria")
  description         String        @db.Text
  strategicNotes      String?       @db.Text
  boothNumber         String?
  imageUrl            String?       @db.Text
  isFeatured          Boolean       @default(false)
  isPublished         Boolean       @default(true)
  expectedAttendance  Int           @default(0)
  isFifthLabAttending Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  attendanceManifest  AttendanceRecord[]
  registrations       EventRegistration[]

  @@index([date])
  @@index([isPublished, isFeatured])
  @@map("events")
}

// 👥 Internal Staff Attendance Manifest (@thefifthlab.com employees)
model AttendanceRecord {
  id          String           @id @default(cuid())
  userId      String
  eventId     String
  status      AttendanceStatus @default(ATTENDING)
  isCheckedIn Boolean          @default(false)
  checkedInAt DateTime?
  confirmedAt DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("attendance_records")
}

// 🎟️ Public Visitor Event Registrations (Open to any public email / attendees)
model EventRegistration {
  id           String     @id @default(cuid())
  eventId      String
  visitorName  String
  email        String
  phone        String
  company      String
  ticketTier   TicketTier @default(FREE_VISITOR)
  qrPassCode   String     @unique
  isCheckedIn  Boolean    @default(false)
  checkedInAt  DateTime?
  createdAt    DateTime   @default(now())

  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, email])
  @@map("event_registrations")
}

// 🎤 Pro Organizer Event Pitches & Proposals (Submitted to FifthLab for Co-hosting / Sponsorship)
model EventPitch {
  id                      String      @id @default(cuid())
  organizerName           String
  organization            String
  email                   String
  phone                   String
  eventTitle              String
  proposedDate            DateTime
  proposedCity            String
  expectedAudience        Int         @default(500)
  pitchDescription        String      @db.Text
  sponsorshipRequested    String?     @db.Text
  status                  PitchStatus @default(SUBMITTED)
  adminReviewNotes        String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([status])
  @@map("event_pitches")
}

// 💼 Ingested Public Visitor Leads (Demo Requests for Bulkwave, Smerp, Finedge, Kuleanpay)
model Lead {
  id                    String     @id @default(cuid())
  visitorName           String
  company               String
  email                 String
  phone                 String
  productInterested     String
  assignedProductOwnerId String?
  bookingDate           DateTime?
  bookingTime           String?
  status                LeadStatus @default(UNREAD)
  notes                 String?    @db.Text
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  assignedOwner         User?      @relation(fields: [assignedProductOwnerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// 📦 Enterprise Product Solutions Catalog
model Product {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  tagline              String
  description          String   @db.Text
  iconName             String   @default("Briefcase")
  bgColor              String   @default("#F4F4FF")
  ownerId              String?
  activeDemosThisMonth Int      @default(0)
  availableSlots       String[] @default(["09:00 AM", "11:00 AM", "02:00 PM", "04:00 PM"])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner                User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("products")
}

// ✉️ Public Newsletter & Event Notification Subscriptions
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("HOMEPAGE")
  createdAt DateTime @default(now())

  @@map("newsletter_subscriptions")
}
